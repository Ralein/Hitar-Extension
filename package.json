{
  "name": "hitar-extension",
  "version": "0.1.0",
  "description": "Live page translator using free, self-hostable LibreTranslate backend for Chrome, Edge, and Firefox.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:all": "wxt build && wxt build -b firefox && wxt build -b edge",
    "zip": "wxt zip",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b edge",
    "compile": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate-assets": "node scripts/generate-assets.js"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/webextension-polyfill": "^0.12.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.1",
    "happy-dom": "^16.8.1",
    "playwright": "^1.50.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "wxt": "^0.19.26"
  }
}
